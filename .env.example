# Backend gateway base URL. Optional — defaults to prod when unset.
#   dev:  https://aiplatform.console-dev.vngcloud.tech/agent-api
#   prod: https://agent-rag.api.vngcloud.vn  (default)
BACKEND_URL=https://aiplatform.console-dev.vngcloud.tech/agent-api

TRANSPORT=stdio
PORT=8080

# stdio only: OAuth bearer token + optional RAG engine (agent name) scoping search/list
GREENNODE_RAG_TOKEN=
ENGINE=
TOKEN_ENV=GREENNODE_RAG_TOKEN

MAX_RESPONSE_BYTES=25000
DEFAULT_PAGE_SIZE=10
MAX_GET_DOCUMENT_PAGES=10

# Logs go to stderr (never stdout, so stdio JSON-RPC is never corrupted).
# debug = per-call backend traces; info = start/end + ingest summary (default).
LOG_LEVEL=info
# Hard timeout (ms) for each backend call (search, list, upload, …).
# On timeout the tool returns a 504-style error instead of hanging. 0 = no timeout.
BACKEND_TIMEOUT_MS=300000
